# Save to <Pi agent directory>/config/pi-extensions/.env.web-search.
# Auto (default): DeepSeek credentials first, otherwise AnySearch credentials.
# Set provider=deepseek or provider=anysearch to pin one channel.
provider=auto
base_url=https://api.deepseek.com
# api_key=replace-with-your-own-deepseek-key

# AnySearch ignores the DeepSeek fields above and never reuses its auth.json key.
# anysearch_api_key=replace-with-your-own-anysearch-key
# anysearch_base_url=https://api.anysearch.com
